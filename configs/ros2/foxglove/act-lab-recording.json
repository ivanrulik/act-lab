{
  "name": "ACT Lab ROS recording replay",
  "configById": {
    "Image!wrist": {
      "title": "Original wrist RGB",
      "synchronize": false,
      "rectify": false,
      "imageMode": {
        "imageTopic": "/act_lab/recording/v1/camera/wrist/image_raw",
        "calibrationTopic": "/act_lab/recording/v1/camera/wrist/camera_info"
      }
    },
    "RawMessages!report": {
      "topicPath": "/act_lab/recording/v1/command_report",
      "diffEnabled": false
    },
    "RawMessages!packet": {
      "topicPath": "/act_lab/recording/v1/packet",
      "diffEnabled": false
    },
    "Plot!age": {
      "title": "Source command age (ms)",
      "paths": [
        {
          "value": "/act_lab/recording/v1/command_report.command_age_ms",
          "enabled": true,
          "timestampMethod": "receiveTime"
        }
      ]
    },
    "Image!overview": {
      "title": "Original overview RGB",
      "synchronize": false,
      "rectify": false,
      "imageMode": {
        "imageTopic": "/act_lab/recording/v1/camera/overview/image_raw",
        "calibrationTopic": "/act_lab/recording/v1/camera/overview/camera_info"
      }
    },
    "Image!policy": {
      "title": "Original policy RGB",
      "synchronize": false,
      "rectify": false,
      "imageMode": {
        "imageTopic": "/act_lab/recording/v1/camera/policy/image_raw",
        "calibrationTopic": "/act_lab/recording/v1/camera/policy/camera_info"
      }
    }
  },
  "layout": {
    "direction": "row",
    "first": {
      "direction": "column",
      "first": "Image!wrist",
      "second": {
        "direction": "row",
        "first": "Image!overview",
        "second": "Image!policy"
      },
      "splitPercentage": 60
    },
    "second": {
      "direction": "column",
      "first": "Plot!age",
      "second": {
        "direction": "row",
        "first": "RawMessages!report",
        "second": "RawMessages!packet"
      }
    },
    "splitPercentage": 55
  },
  "globalVariables": {}
}
