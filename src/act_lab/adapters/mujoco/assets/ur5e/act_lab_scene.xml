<mujoco model="ACT Lab UR5e cube-to-tray task">
  <include file="ur5e.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0.1 0.1 0.1"/>
    <global azimuth="135" elevation="-25"/>
  </visual>

  <asset>
    <texture name="floor_grid" type="2d" builtin="checker" width="256" height="256"
      rgb1="0.16 0.18 0.2" rgb2="0.22 0.24 0.26"/>
    <material name="floor_material" texture="floor_grid" texrepeat="4 4" texuniform="true"/>
    <material name="table_material" rgba="0.45 0.32 0.22 1"/>
    <material name="tray_material" rgba="0.15 0.35 0.65 1"/>
    <material name="cube_material" rgba="0.85 0.25 0.12 1"/>
  </asset>

  <worldbody>
    <light name="task_light" pos="0.5 -0.2 1.6" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="2 2 0.05" material="floor_material"/>
    <geom name="table" type="box" pos="0.55 0 0.2" size="0.45 0.4 0.2"
      material="table_material" contype="1" conaffinity="1"/>

    <body name="tray" pos="0.58 0.23 0.41">
      <geom name="tray_floor" type="box" size="0.12 0.10 0.01" material="tray_material"/>
      <geom name="tray_left_wall" type="box" pos="0.13 0 0.035"
        size="0.01 0.11 0.045" material="tray_material"/>
      <geom name="tray_right_wall" type="box" pos="-0.13 0 0.035"
        size="0.01 0.11 0.045" material="tray_material"/>
      <geom name="tray_front_wall" type="box" pos="0 0.11 0.035"
        size="0.12 0.01 0.045" material="tray_material"/>
      <geom name="tray_back_wall" type="box" pos="0 -0.11 0.035"
        size="0.12 0.01 0.045" material="tray_material"/>
    </body>

    <body name="cube" pos="0.45 -0.15 0.425">
      <freejoint name="cube_free_joint"/>
      <geom name="cube_geom" type="box" size="0.025 0.025 0.025" mass="0.08"
        material="cube_material" friction="1.0 0.01 0.001"/>
    </body>

    <camera name="overview" pos="1.45 -1.25 1.25" xyaxes="0.72 0.69 0 -0.4 0.42 0.81"/>
    <camera name="policy" pos="0.95 -0.7 0.9" xyaxes="0.8 0.6 0 -0.34 0.45 0.83"/>
  </worldbody>
</mujoco>
