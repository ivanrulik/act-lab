# ROS-native Python and NumPy remain isolated from ACT training/simulation wheels.
FROM ros:jazzy-ros-base-noble@sha256:066420e07f60aa18262f2479981def87ebcfcec42eefb0c0c57c4a46098348ca
RUN apt-get update && apt-get install --yes --no-install-recommends \
    build-essential cmake python3-colcon-common-extensions python3-venv \
    ros-jazzy-rosidl-default-generators ros-jazzy-geometry-msgs \
    ros-jazzy-std-msgs ros-jazzy-rosgraph-msgs ros-jazzy-rmw-fastrtps-cpp \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv --system-site-packages /opt/act-lab-venv \
    && /opt/act-lab-venv/bin/pip install --no-cache-dir pytest==8.4.2
COPY ros2 /opt/act-lab-ros/src
RUN . /opt/ros/jazzy/setup.sh && cd /opt/act-lab-ros \
    && colcon build --cmake-args -DPython3_EXECUTABLE=/usr/bin/python3 \
    && dpkg-query -W > /opt/act-lab-ros/packages.txt
RUN useradd --create-home actlab
COPY scripts/ros2-entrypoint.sh /usr/local/bin/ros2-entrypoint
COPY scripts/ros2-act-lab.sh /usr/local/bin/act-lab
RUN chmod 0755 /usr/local/bin/ros2-entrypoint /usr/local/bin/act-lab
COPY src /workspace/src
COPY tests /workspace/tests
COPY pyproject.toml /workspace/
ENV PATH=/opt/act-lab-venv/bin:$PATH PYTHONPATH=/workspace/src \
    RMW_IMPLEMENTATION=rmw_fastrtps_cpp ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST ROS_DOMAIN_ID=42 \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /workspace
USER actlab
ENTRYPOINT ["/usr/local/bin/ros2-entrypoint"]
CMD ["act-lab", "ros2", "contract-smoke", "--json"]
